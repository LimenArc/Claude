<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/videoListFragment">

    <fragment
        android:id="@+id/videoListFragment"
        android:name="com.aethermon.streamer.ui.VideoListFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_video_list">

        <action
            android:id="@+id/action_videoList_to_player"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.aethermon.streamer.ui.VideoPlayerFragment"
        android:label="{video.name}"
        tools:layout="@layout/fragment_video_player">

        <argument
            android:name="video"
            app:argType="com.aethermon.streamer.data.VideoItem" />
    </fragment>

</navigation>
