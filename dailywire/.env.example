# Copy to .env and fill in. dailywire loads .env automatically.
# The config file names these variables; it never stores the values.

# Language model, for summaries and the script. Any OpenAI-compatible endpoint.
# Local servers (llama.cpp, Ollama, LM Studio) usually need no key at all --
# leave this blank and just point [llm].base_url at them in config.toml.
DAILYWIRE_LLM_API_KEY=

# Hosted text to speech, only if [tts].provider = "hosted".
# The default Piper provider is local and needs no key.
DAILYWIRE_TTS_API_KEY=
