<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- GL container -->
    <FrameLayout
        android:id="@+id/gl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Generating overlay -->
    <LinearLayout
        android:id="@+id/layout_generating"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF000020"
        android:visibility="visible">
        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/accent_neon"
            android:layout_marginBottom="16dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generating World..."
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Procedurally building your 3D game"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- HUD top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/hud_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_game_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Game"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="@color/accent_neon"
            android:textSize="13sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tv_lives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lives: 3"
            android:textColor="#FFFF5555"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="||"
            android:textSize="10sp"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Look area (right half) -->
    <View
        android:id="@+id/look_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="160dp" />

    <!-- D-pad (bottom left) -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_forward"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:text="▲"
            android:textSize="18sp"
            android:padding="0dp"
            app:backgroundTint="@color/control_bg"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:text="▼"
            android:textSize="18sp"
            android:padding="0dp"
            app:backgroundTint="@color/control_bg"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_left"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|start"
            android:text="◀"
            android:textSize="18sp"
            android:padding="0dp"
            app:backgroundTint="@color/control_bg"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_right"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:text="▶"
            android:textSize="18sp"
            android:padding="0dp"
            app:backgroundTint="@color/control_bg"
            app:cornerRadius="8dp" />
    </FrameLayout>

    <!-- Jump button (bottom right, shown for platform games) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_jump"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="JUMP"
        android:textSize="11sp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@color/accent_neon"
        app:cornerRadius="36dp" />

</FrameLayout>
